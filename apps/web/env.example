# The publishable key is safe to ship to the browser -- RLS is what protects
# the data, not the key. The secret key must never appear here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The Google OAuth client for connecting a trip calendar (#12), not the
# sign-in one. A client ID is public; its secret lives only in the calendar
# Edge Function's secrets.
VITE_GOOGLE_CALENDAR_CLIENT_ID=
