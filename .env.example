# Used by the Supabase CLI (db push, gen types). Not read by the app.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Not needed locally. GitHub Actions repository secrets for the keepalive
# workflow (.github/workflows/keepalive.yml): SUPABASE_PROJECT_REF (same
# value as above) and SUPABASE_PUBLISHABLE_KEY (Project Settings > API Keys).
